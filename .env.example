# .env.example — copy to .env and fill in.
#   cp .env.example .env
# .env is gitignored; never commit real values.

# Ollama that does the summarizing. Default: Ollama on the docker host
# itself (http://host.docker.internal:11434). Set this for another machine.
OLLAMA_HOST=

# Optional: enables Hetzner's hosted inference as a second, selectable
# summarization backend ("hetzner:<model>" in the model dropdown/CLI arg),
# alongside Ollama. Free while it stays experimental;
# rate-limited per key to 10 requests / 4M input / 100k output tokens per 60s.
# Leave empty to omit it entirely — the dropdown just won't offer it.
# Token: https://experiments.hetzner.com -> APPS -> Inference -> Create API Token
# (the Experiments portal, not the Cloud Console; same Hetzner login)
HETZNER_INFERENCE_API_KEY=

# Optional: context window requested per Ollama request (default 32768).
# Ollama gives the prompt only half of num_ctx and drops the front of
# anything longer without reporting an error, so this needs to be about 2x
# the longest transcript you expect, in tokens. Lower it if the Ollama GPU's VRAM
# is needed elsewhere — the KV cache scales with this value.
OLLAMA_NUM_CTX=

# Optional: tags every video with TypeSafe's Jev too (via Vercel AI Gateway),
# shown next to laya's tag for comparison. Needs a card on file at Vercel to
# unlock the free $5/month credit; a video costs about $0.00003.
AI_GATEWAY_API_KEY=

# Optional: topic tagging (IT / POLITICS / OTHER) with laya, served by
# Ollaya, e.g. http://<host>:11435. Leave empty to turn tagging off.
LAYA_HOST=

# Optional: name of a custodes container that hands out GPU leases; jobs
# wait for a lease before calling Ollama. Leave empty to call Ollama
# directly. Needs the docker socket mount in docker-compose.yaml.
CUSTODES_CONTAINER=
